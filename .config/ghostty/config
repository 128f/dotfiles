# Theme
theme = Cobalt2

# Font
font-family = Fira Code
font-size = 13

# Transparency & blur
background-opacity = 0.88
background-blur-radius = 20

# Window
window-padding-x = 4
window-padding-y = 4
window-inherit-working-directory = true

quit-after-last-window-closed = true
shell-integration-features = no-cursor
